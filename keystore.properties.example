# Copie este arquivo para "keystore.properties" (na raiz do projeto,
# já gitignorado) e preencha com os dados do SEU keystore de release.
# Nunca commite o arquivo real nem o .jks/.keystore.
#
# Gerar um keystore novo:
#   keytool -genkeypair -v -keystore release.keystore -alias cielotickets \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=cielotickets
keyPassword=CHANGE_ME
